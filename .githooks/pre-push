#!/bin/sh
# Before a push that changes search or grouping code, run the evals on the eval branch
# (eval/run.py) and stop the push when one got worse than its baseline, or when the
# eval itself crashes. The naming eval, which calls the tree model, runs only when the
# push touches naming code. Enable once per clone:
#   git config core.hooksPath .githooks
# Push past it once with: git push --no-verify

cd "$(git rev-parse --show-toplevel)" || exit 1
zero=0000000000000000000000000000000000000000
watched="db.py grouping.py eval/"
naming_code='_name_tree|TREE_MODEL|MIN_BIG|MAX_BIG|BigCategor|_bare|_output_language_ok|b/eval/naming\.py'

changed=""
naming=""
while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue  # deleting a remote branch
    if [ "$remote_sha" = "$zero" ] || ! git cat-file -e "$remote_sha" 2>/dev/null; then
        changed="new branch"  # nothing local to diff against: score it
    else
        # shellcheck disable=SC2086
        changed="$changed$(git diff --name-only "$remote_sha" "$local_sha" -- $watched)"
        # hunk headers name the enclosing function, so an edit inside _name_tree matches too
        if git diff "$remote_sha" "$local_sha" -- grouping.py eval/naming.py | grep -qE "$naming_code"; then
            naming="--naming --repeat 3"  # one tree in three fails its checks; judge three
        fi
    fi
done
[ -z "$changed" ] && exit 0

if ! grep -q '^EVAL_DATABASE_URL=' .env 2>/dev/null; then
    echo "pre-push: no EVAL_DATABASE_URL in .env, so the search eval is skipped" >&2
    exit 0
fi
# shellcheck disable=SC2086
if ! git diff --quiet HEAD -- $watched; then
    echo "pre-push: uncommitted changes in search code are scored too" >&2
fi
echo "pre-push: search or grouping code changed; running the evals ${naming:+(with naming) }on the eval branch" >&2
# shellcheck disable=SC2086
uv run --group eval --env-file .env python eval/run.py $naming >&2 || {
    echo "pre-push: an eval got worse or failed (above); push anyway with git push --no-verify" >&2
    exit 1
}
